# ==============================================================================
# Function: pf
# Description: Interactive package search, preview, and installer for Arch Linux
#              using the 'paru' AUR helper and 'fzf' fuzzy finder.
# Usage: pf
# Dependencies: paru, fzf
# ==============================================================================
pf() {
    if ! (( $+commands[paru] )); then
        echo "Error: paru is required for pf (Arch Linux / AUR helper)" >&2
        return 1
    fi
    if ! (( $+commands[fzf] )); then
        echo "Error: fzf is required for pf" >&2
        return 1
    fi

    paru -Slq | fzf --multi --preview 'paru -Sii {1}' --preview-window=down:75% | xargs -ro paru -S
}
